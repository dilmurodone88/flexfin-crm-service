# Nusxa oling: .env (git'ga tushmaydi). Parol/kalitlarni FAQAT shu faylga yozing.

# Windows autentifikatsiya (Windows xostda): hech narsa yaratish shart emas.
DATABASE_URL="sqlserver://localhost:1433;database=FlexFin;integratedSecurity=true;trustServerCertificate=true;commandTimeout=20;connectionLimit=5"
# Docker (Linux) yoki alohida xost: faqat-o'qiydigan SQL login tavsiya etiladi (sql/readonly-login.sql, o'zingiz ishga tushirasiz):
# DATABASE_URL="sqlserver://192.168.3.109:1433;database=FlexFin;user=LOGIN;password=PAROL;trustServerCertificate=true;commandTimeout=20;connectionLimit=5"

PORT=8085
HOST=0.0.0.0

# Kamida 24 belgi (openssl rand -hex 32). Mijoz `x-api-key` sarlavhasida yuboradi.
API_KEY=

# Faqat shu IP'lardan ruxsat (vergul bilan).
ALLOWED_IPS=192.168.21.4
# nginx orqasida: nginx IP'si (docker-compose'da 172.28.0.10). Shunda haqiqiy mijoz IP'si X-Forwarded-For'dan olinadi.
TRUSTED_PROXIES=

# Katta jadvallar (loglar) bloklangan. Bo'sh qoldirsangiz hammasi ochiladi.
BLOCK_MODELS=SystemLog,SystemLogValues
# Pasport/telefon/PINFL kabi ustunlar "***". Parol/hash doim yashirin (bu bayroqqa bog'liq emas).
EXPOSE_PII=false

# Barqarorlik
MAX_TAKE=1000
MAX_CONCURRENT=8
MAX_STREAMS=10
DB_TIMEOUT_MS=25000
FEED_POLL_MS=2000
RATE_LIMIT_PER_MIN=600

# Log (JSON qator). Docker'da LOG_FILE=false (loglarni Docker yig'adi); Windows'da true (kunlik fayl, eskilari o'chadi).
LOG_LEVEL=info
LOG_FILE=false
LOG_DIR=logs
LOG_RETENTION_FILES=30

SWAGGER_ENABLED=true
# nginx orqasida false
COMPRESS=true
