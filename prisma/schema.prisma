// flexfin-crm-service: FlexFin bazasining TO'LIQ Prisma schema'si (bog'lanishlari bilan).
// Manba: schema-dump.txt (sys.* metama'lumoti): 288 jadval, 472 ta @relation.
// Yig'ildi: node scripts/build-schema-from-dump.cjs  (baza bilan ulanishsiz).
//
// ESLATMA: decimal(p,s) aniqligi dump'da yo'q, shuning uchun Decimal standart aniqlikda. O'qish uchun farqi yo'q;
// aniq qiymatlar kerak bo'lsa: 109 da `prisma db pull` + `npm run schema:build` (docs/SCHEMA.md).
// Primary key'siz jadvallar @@ignore (Prisma ularni modelga aylantirmaydi): servis ularni /v1/raw orqali o'qiydi.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "sqlserver"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
  schemas      = ["Affiliation", "CBReport", "CLRUtil", "CdcCore", "CloseOperDay", "CollateralRegistry", "Crif", "DCR", "DebtCollector", "FlexFinApi", "Grki", "Legalisation", "LegalizationUpdater", "PMT", "Report", "ReportGenerator", "dbo"]
}

model Relation {
  GCRecord Int?
  OID BigInt @id
  SelectPermission BigInt?
  UpdatePermission BigInt?
  DeletePermission BigInt?
  InfluentialClient BigInt
  DependentClient BigInt
  RelationTypeOID BigInt
  CreateReason String? @db.NVarChar(256)
  CreatedBy BigInt?
  CreationTime DateTime @db.DateTime2
  RelationTypeOIDRel RelationType @relation("Relation_RelationTypeOID", fields: [RelationTypeOID], references: [OID], onDelete: NoAction, onUpdate: NoAction)
  InfluentialClientRel BaseClient @relation("Relation_InfluentialClient", fields: [InfluentialClient], references: [OID], onDelete: NoAction, onUpdate: NoAction)
  DependentClientRel BaseClient @relation("Relation_DependentClient", fields: [DependentClient], references: [OID], onDelete: NoAction, onUpdate: NoAction)
  GCRecordRel XPDeletedObject? @relation("Relation_GCRecord", fields: [GCRecord], references: [OID], onDelete: NoAction, onUpdate: NoAction)
  CreatedByRel isUser? @relation("Relation_CreatedBy", fields: [CreatedBy], references: [OID], onDelete: NoAction, onUpdate: NoAction)

  @@index([RelationTypeOID])
  @@index([InfluentialClient])
  @@index([DependentClient])
  @@index([GCRecord])
  @@index([CreatedBy])
  @@schema("Affiliation")
}

